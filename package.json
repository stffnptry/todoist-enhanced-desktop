{
  "name": "enhanced-for-todoist-desktop-de",
  "private": true,
  "version": "1.0.0",
  "description": "Deutsche Ausgabe: ein natives Fenster um Enhanced for Todoist mit globalem Schnellerfassen. Die Web-App ist mit deutscher Übersetzung eingebaut.",
  "author": "Jules-Valentin Bertolino",
  "license": "MIT",
  "homepage": "https://github.com/julesvbertolino/todoist-enhanced-desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.julesbertolino.todoistenhanced.desktop.de",
    "productName": "Enhanced for Todoist DE",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "web/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Enhanced-for-Todoist-DE-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de"
        ]
      }
    },
    "electronLanguages": [
      "de",
      "en"
    ]
  },
  "productName": "Enhanced for Todoist DE"
}
